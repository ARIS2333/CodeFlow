# Credentials for the shared "research mode" model. Students who enter the
# research password below use these; everyone else supplies their own.
# PROVIDER must be one of: openai, dashscope, anthropic, deepseek.
API_KEY=
BASE_URL=https://api.openai.com/v1
MODEL=gpt-5.6-sol
PROVIDER=openai

# The study password that unlocks the credentials above. Leave it empty to
# disable research mode entirely, so the deployment is bring-your-own-key only.
# Never commit a real value: this repository is public.
RESEARCH_PASSWORD=
