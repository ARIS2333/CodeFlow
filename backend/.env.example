MODEL_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
QWEN_MODEL=

# Render injects this automatically in production (see render.yaml).
# Locally, point it at your own Postgres instance.
DATABASE_URL=postgresql://codeflow:codeflow@127.0.0.1:5432/codeflow

# Per-worker connection pool. Keep
#   WEB_CONCURRENCY * (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# below the instance's connection limit (100 on Basic plans).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
