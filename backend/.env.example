# Copy this file to backend/.env for local development.
#
# Option A: a local PostgreSQL instance created with backend/setup_local_db.sh
DATABASE_URL=postgresql://localhost/codeflow_study

# Option B: use the External Database URL from Render instead. Add
# ?sslmode=require if it is not already present.
# DATABASE_URL=postgresql://USER:PASSWORD@EXTERNAL_HOST/DATABASE?sslmode=require

# Credentials for the shared "research mode" model. Students who enter the
# research password below use these; everyone else supplies their own.
# PROVIDER must be one of: openai, dashscope, anthropic, deepseek.
API_KEY=
BASE_URL=https://api.openai.com/v1
MODEL=gpt-5.6-sol
PROVIDER=openai

# The study password that unlocks both the model and submission endpoints.
# Never commit a real value: this repository is public.
RESEARCH_PASSWORD=
